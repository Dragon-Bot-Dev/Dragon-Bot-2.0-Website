---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import CommandCard from '../components/CommandCard.astro';
import Icon from '../components/Icon.astro';
import { commandGroups, totalCommands } from '../data/commands';
---

<Layout
  title="Commands | Dragon Bot 2.0"
  description="Every Dragon Bot 2.0 slash command: war and CWL tools, clan and player lookups, reminder settings, and update notes."
>
  <section class="mx-auto max-w-6xl page-x pb-6 pt-14">
    <SectionHeader
      as="h1"
      title="Commands"
      lead={`${totalCommands} slash commands. Commands marked "Needs a linked clan" only work after /setclantag has been run in the server.`}
    />

    <div class="mt-8 max-w-md">
      <label for="cmd-search" class="sr-only">Search commands</label>
      <div class="relative">
        <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-slate-400">
          <Icon name="search" size={18} />
        </span>
        <input
          id="cmd-search"
          type="search"
          placeholder="Search commands"
          autocomplete="off"
          class="w-full rounded-lg border border-slate-700 bg-slate-900 py-2.5 pl-10 pr-3 text-sm text-white placeholder:text-slate-500 focus:border-ember-500 focus:outline-none"
        />
      </div>
    </div>

    <div class="mt-4 flex flex-wrap gap-2" role="group" aria-label="Filter by category">
      <button type="button" data-filter="all" aria-pressed="true" class="filter-chip rounded-lg border px-3 py-1.5 text-sm">All</button>
      {commandGroups.map((g) => (
        <button type="button" data-filter={g.id} aria-pressed="false" class="filter-chip rounded-lg border px-3 py-1.5 text-sm">{g.category}</button>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-6xl space-y-12 page-x pb-20 pt-6">
    {commandGroups.map((group) => (
      <div class="command-group" data-group={group.id}>
        <div class="mb-5 border-b border-slate-800 pb-3">
          <h2 class="text-xl font-bold text-white">{group.category}</h2>
          <p class="text-sm text-slate-400">{group.blurb}</p>
        </div>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
          {group.commands.map((cmd) => (
            <CommandCard {...cmd} category={group.category} />
          ))}
        </div>
      </div>
    ))}

    <p id="no-results" class="hidden py-12 text-slate-400">No commands match that search.</p>
  </section>
</Layout>

<style>
  .filter-chip {
    border-color: rgb(51 65 85);
    color: rgb(203 213 225);
    background: transparent;
  }
  .filter-chip:hover { color: #fff; border-color: rgb(100 116 139); }
  .filter-chip[aria-pressed='true'] {
    background: rgb(234 88 12);
    border-color: rgb(234 88 12);
    color: #fff;
  }
</style>

<script>
  const input = document.getElementById('cmd-search') as HTMLInputElement | null;
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-chip'));
  const groups = Array.from(document.querySelectorAll<HTMLElement>('.command-group'));
  const empty = document.getElementById('no-results');
  let activeFilter = 'all';

  function apply() {
    const q = (input?.value ?? '').trim().toLowerCase().replace(/^\//, '');
    let totalVisible = 0;

    groups.forEach((group) => {
      const inCategory = activeFilter === 'all' || group.dataset.group === activeFilter;
      let visibleInGroup = 0;
      group.querySelectorAll<HTMLElement>('.command-card').forEach((card) => {
        const match = inCategory && (q === '' || (card.dataset.search ?? '').includes(q));
        card.classList.toggle('hidden', !match);
        if (match) visibleInGroup++;
      });
      group.classList.toggle('hidden', visibleInGroup === 0);
      totalVisible += visibleInGroup;
    });

    empty?.classList.toggle('hidden', totalVisible !== 0);
  }

  input?.addEventListener('input', apply);
  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      activeFilter = chip.dataset.filter ?? 'all';
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      apply();
    })
  );

  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((button) => {
    button.addEventListener('click', async () => {
      const command = button.dataset.command ?? '';
      const copyIcon = button.querySelector('.copy-icon');
      const checkIcon = button.querySelector('.check-icon');
      try {
        await navigator.clipboard.writeText(command);
        copyIcon?.classList.add('hidden');
        checkIcon?.classList.remove('hidden');
        setTimeout(() => {
          copyIcon?.classList.remove('hidden');
          checkIcon?.classList.add('hidden');
        }, 2000);
      } catch (err) {
        console.error('Failed to copy:', err);
      }
    });
  });
</script>
