---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import DiscordEmbed from '../components/DiscordEmbed.astro';
import FaqList from '../components/FaqList.astro';
import Rule from '../components/Rule.astro';
import { LINKS } from '../config';
import { homeFaq } from '../data/faq';

const features = [
  {
    id: 'reminders',
    title: 'War and CWL reminders',
    body: "Dragon Bot watches your clan's wars and posts who still has attacks left. You pick when it reminds (default 4 hours and 1 hour before the end). The final reminder pings members who have linked their account.",
    points: [
      'Works for regular wars and every CWL round',
      'Posts a results summary when the war ends',
      'Only posts when someone still has attacks to use',
    ],
  },
  {
    id: 'activity',
    title: 'War activity tracking',
    body: 'Each finished war is recorded, so /waractivity can rank your roster by how many of their attacks they actually used. Useful when you are choosing the next lineup.',
    points: [
      'Ranked by attacks used, then stars, with average destruction',
      "Add a member to see that player's war-by-war history",
      'Every CWL round counts on its own',
    ],
  },
  {
    id: 'updates',
    title: 'Update notes',
    body: "Set a news channel and the bot posts new update and balance-change notes from Supercell's official Clash of Clans blog. /patchnotes shows the latest on demand.",
    points: [
      'Checks the official blog every 6 hours',
      '/receiveposts pulls recent posts from a subreddit, r/ClashOfClansLeaks by default',
    ],
  },
];

const extras = [
  ['Capital Raid reminders', 'One reminder with 24 hours left in Raid Weekend, listing members with attacks unused.'],
  ['CWL scouting', "Each opposing clan's Town Hall spread and war streak, and your round-by-round schedule."],
  ['Clan and player lookups', 'Rosters, clan info, player profiles, troops, heroes, equipment and pets.'],
  ['Account linking', 'Link your player tag with your in-game API token, so the bot can mention you and fill in your tag.'],
];

const steps = [
  ['Add the bot to your server.', null],
  ['Link your clan and choose where reminders go.', '/setclantag #YOURTAG'],
  ['Optional: link your own account.', '/link'],
];
---

<Layout>
  <!-- Hero -->
  <section>
    <div class="mx-auto grid max-w-6xl items-center gap-12 page-x py-16 md:py-20 lg:grid-cols-[1.1fr_1fr]">
      <div class="min-w-0">
        <h1 class="text-4xl font-bold leading-tight text-white md:text-5xl">
          Never miss a war attack again.
        </h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-slate-300">
          Dragon Bot is a Discord bot for Clash of Clans clans. It reminds members who still have attacks left in wars, CWL and Capital Raids, and keeps a record of who actually shows up.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <Button href={LINKS.invite} external variant="discord" size="lg" icon="discord">Add to Discord</Button>
          <Button href="/commands" variant="secondary" size="lg">See commands</Button>
        </div>
        <p class="mt-4 text-sm text-slate-400">Free to use.</p>
      </div>

      <DiscordEmbed
        title="4 HOURS REMAINING: War Status Report"
        color="#f97316"
        footer="Clan Tag: #EXAMPLE | 🔗 = Linked Player"
        caption="Example reminder. Names and numbers are made up."
      >
        <p class="text-dc-text"><strong class="text-white">Rising Phoenix</strong> vs <strong class="text-white">Night Raiders</strong></p>
        <p class="text-dc-muted">Type: <code class="rounded bg-black/30 px-1">Standard</code> | Remaining: <code class="rounded bg-black/30 px-1">3/15</code></p>
        <p class="mt-3 text-xs font-semibold text-white">Pending Attacks</p>
        <ul class="mt-1 space-y-0.5 text-dc-text">
          <li>3. <strong>Rook</strong> (2 left)</li>
          <li>7. <strong>Ember</strong> (1 left)</li>
          <li>12. <strong>Talon</strong> (2 left)</li>
        </ul>
        <div class="mt-3 grid grid-cols-2 gap-3">
          <div>
            <p class="text-xs font-semibold text-white">Scoreboard</p>
            <p class="text-dc-text">⭐ <code class="rounded bg-black/30 px-1">28</code> vs ⭐ <code class="rounded bg-black/30 px-1">24</code></p>
          </div>
          <div>
            <p class="text-xs font-semibold text-white">Ends</p>
            <p class="text-dc-text">in 4 hours</p>
          </div>
        </div>
      </DiscordEmbed>
    </div>
  </section>
  <Rule />

  <!-- Features -->
  <section class="mx-auto max-w-6xl page-x">
    {features.map((f, i) => (
      <div class="grid items-start gap-8 border-b border-slate-800 py-14 lg:grid-cols-2 lg:gap-16">
        <div class={`min-w-0 ${i % 2 === 1 ? 'lg:order-2' : ''}`}>
          <h2 class="text-2xl font-bold text-white">{f.title}</h2>
          <p class="mt-3 leading-relaxed text-slate-300">{f.body}</p>
          <ul class="mt-5 list-disc space-y-2 pl-5 text-slate-300 marker:text-slate-500">
            {f.points.map((p) => <li>{p}</li>)}
          </ul>
        </div>

        <div class={`min-w-0 ${i % 2 === 1 ? 'lg:order-1' : ''}`}>
          {f.id === 'reminders' && (
            <DiscordEmbed title="Final Warning: War Status Report" color="#ef4444" footer="Clan Tag: #EXAMPLE | 🔗 = Linked Player">
              <p class="text-dc-muted">Type: <code class="rounded bg-black/30 px-1">CWL</code> | Remaining: <code class="rounded bg-black/30 px-1">2/15</code></p>
              <p class="mt-3 text-xs font-semibold text-white">Pending Attacks</p>
              <ul class="mt-1 space-y-0.5">
                <li>4. <span class="rounded bg-blurple/30 px-1 text-indigo-200">@Rook</span> (1 left)</li>
                <li>9. <strong>Talon</strong> (1 left)</li>
              </ul>
            </DiscordEmbed>
          )}

          {f.id === 'activity' && (
            <DiscordEmbed command="/waractivity" color="#3b82f6">
              <div class="overflow-x-auto">
                <pre class="rounded bg-black/30 p-3 font-mono text-xs leading-relaxed text-dc-text">War Activity — Last 10 Days
Clan: Rising Phoenix (#EXAMPLE)

 1. Rook (TH17): Wars:3 Atks:4/4 (100%)
    Stars:12 AvgDmg:133.3%
 2. Ember (TH16): Wars:3 Atks:4/4 (100%)
    Stars:10 AvgDmg:118.0%
 3. Talon (TH15): Wars:2 Atks:1/2 (50%)
    Stars:3 AvgDmg:55.0%

No War Activity in the Last 10 Days:
 1. Ash</pre>
              </div>
            </DiscordEmbed>
          )}

          {f.id === 'updates' && (
            <DiscordEmbed command="/patchnotes" color="#22c55e">
              <p class="font-semibold text-white">📰 Monthly Update</p>
              <p class="text-xs text-dc-muted">Posted from Supercell's official blog</p>
              <div class="mt-3 overflow-x-auto">
                <pre class="rounded bg-black/30 p-3 font-mono text-xs leading-relaxed text-dc-text">== New Content ==
Example new level or feature

== Balance Changes ==
Example troop change

== Bug Fixes ==
Example fix</pre>
              </div>
            </DiscordEmbed>
          )}
        </div>
      </div>
    ))}
  </section>

  <!-- Extras -->
  <section class="mx-auto max-w-6xl page-x py-14">
    <h2 class="text-2xl font-bold text-white">Also included</h2>
    <dl class="mt-6 grid gap-x-12 md:grid-cols-2">
      {extras.map(([term, desc]) => (
        <div class="border-t border-slate-800 py-5">
          <dt class="font-semibold text-white">{term}</dt>
          <dd class="mt-1 text-sm leading-relaxed text-slate-300">{desc}</dd>
        </div>
      ))}
    </dl>
    <p class="mt-4">
      <a href="/commands" class="font-medium text-ember-400 hover:text-ember-300">All commands →</a>
    </p>
  </section>

  <!-- Setup -->
  <Rule />
  <section>
    <div class="mx-auto max-w-6xl page-x py-14">
      <h2 class="text-2xl font-bold text-white">Getting started</h2>
      <ol class="mt-6 max-w-2xl divide-y divide-slate-800 border-y border-slate-800">
        {steps.map(([text, cmd], i) => (
          <li class="grid grid-cols-[1.75rem_1fr] items-baseline py-4">
            <span class="font-mono text-sm text-slate-400">{i + 1}.</span>
            <div>
              <span class="text-slate-200">{text}</span>
              {cmd && <code class="mt-1 block break-words font-mono text-sm text-ember-300 sm:ml-4 sm:inline">{cmd}</code>}
            </div>
          </li>
        ))}
      </ol>
      <p class="mt-4">
        <a href="/setup" class="font-medium text-ember-400 hover:text-ember-300">Full setup guide →</a>
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="mx-auto max-w-6xl page-x pb-14">
    <h2 class="text-2xl font-bold text-white">Common questions</h2>
    <div class="mt-6 max-w-3xl">
      <FaqList items={homeFaq} />
    </div>
    <p class="mt-4">
      <a href="/faq" class="font-medium text-ember-400 hover:text-ember-300">More answers →</a>
    </p>
  </section>

  <!-- CTA -->
  <Rule />
  <section>
    <div class="mx-auto flex max-w-6xl flex-col gap-6 page-x py-14 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 class="text-2xl font-bold text-white">Add Dragon Bot to your server</h2>
        <p class="mt-2 text-slate-300">Then run <code class="font-mono text-ember-300">/setclantag</code> and you are set.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <Button href={LINKS.invite} external variant="discord" size="lg" icon="discord">Add to Discord</Button>
        <Button href={LINKS.discord} external variant="secondary" size="lg">Support server</Button>
      </div>
    </div>
  </section>
</Layout>
