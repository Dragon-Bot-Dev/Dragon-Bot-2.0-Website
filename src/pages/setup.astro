---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import StepCard from '../components/StepCard.astro';
import Button from '../components/Button.astro';
import { LINKS, REMINDER_CHECK_MINUTES } from '../config';

const steps = [
  {
    step: 1,
    title: 'Add Dragon Bot to your server',
    description:
      'Use the Add to Discord button and pick the server your clan uses. You need the Manage Server permission on that server to invite a bot. Leave the default permissions selected.',
    videoSrc: '/videos/Invite.mp4',
  },
  {
    step: 2,
    title: 'Link your clan',
    description:
      'In your server, run /setclantag with your clan tag. You can set the reminder channels and times in the same command, or change them later.',
    options: [
      '<code>war_channel</code>: where war and CWL reminders and summaries are posted',
      '<code>raid_channel</code>: where Capital Raid reminders are posted',
      '<code>reminder_hours_1</code> / <code>reminder_hours_2</code>: hours before the war ends to remind (defaults 4 and 1; set the second to 0 to turn it off)',
    ],
    videoSrc: '/videos/set_clan_tag.mp4',
    note: "Your clan's war log needs to be public in-game for the bot to see its wars.",
  },
  {
    step: 3,
    title: 'Fine-tune channels and news',
    description:
      'Admins can change reminder channels and times at any time, set a channel for official Clash of Clans update notes, or turn a type of post off.',
    command: '/adjust_reminders news_channel:#updates war_channel:#war',
    options: [
      '<code>news_channel</code>: posts new update and balance-change notes from the official blog',
      '<code>disable</code>: turn off war, raid or news posts (or everything)',
      'Run <code>/serverstatus</code> to see your current configuration',
    ],
  },
  {
    step: 4,
    title: 'Link your own account',
    description:
      'Run /link and choose Link CoC Account. Enter your player tag and your in-game API token. This confirms the account is yours, lets the bot mention you in final war reminders, and fills in your tag for player commands.',
    videoSrc: '/videos/player_link.mp4',
    note: 'The video above was recorded before token verification was added, so it does not show the API token field. Follow the steps below for the token.',
  },
];
---

<Layout
  title="Setup Guide | Dragon Bot 2.0"
  description="Set up Dragon Bot 2.0 for your Clash of Clans clan: invite the bot, link your clan, choose reminder channels, and link your account."
>
  <section class="mx-auto max-w-5xl px-5 pb-8 pt-14">
    <SectionHeader
      as="h1"
      title="Setup guide"
      lead="Four steps. Only the first two are required."
    />
    <div class="mt-6">
      <Button href={LINKS.invite} external variant="discord" size="lg" icon="discord">Add to Discord</Button>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-5">
    {steps.map((s) => <StepCard {...s} />)}
  </section>

  <section class="mx-auto max-w-5xl px-5 pb-20">
    <div class="grid gap-10 border-t border-slate-800 pt-10 md:grid-cols-2">
      <div>
        <h2 class="text-xl font-bold text-white">Where to find your API token</h2>
        <ol class="mt-3 list-decimal space-y-2 pl-5 text-sm leading-relaxed text-slate-300">
          <li>Open Clash of Clans, then Settings → More Settings.</li>
          <li>Scroll to the bottom and tap <strong class="text-white">API Token</strong>.</li>
          <li>Copy the 8-character token and paste it into the <code class="font-mono text-ember-300">/link</code> form.</li>
        </ol>
        <p class="mt-3 text-sm text-slate-400">The token only proves you own the account. It cannot be used to log in.</p>
      </div>

      <div>
        <h2 class="text-xl font-bold text-white">Good to know</h2>
        <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-relaxed text-slate-300">
          <li>The bot checks wars every {REMINDER_CHECK_MINUTES} minutes, so a reminder can arrive up to about {REMINDER_CHECK_MINUTES} minutes after its threshold.</li>
          <li>Reminders only post when someone still has attacks left.</li>
          <li>The bot needs permission to view and send messages (with embeds) in the channels you choose.</li>
        </ul>
        <p class="mt-3 text-sm">
          <a href="/faq" class="font-medium text-ember-400 hover:text-ember-300">Troubleshooting in the FAQ →</a>
        </p>
      </div>
    </div>
  </section>
</Layout>
