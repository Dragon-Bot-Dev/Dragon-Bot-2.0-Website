---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
---

<Layout title="Page not found | Dragon Bot 2.0" noindex>
  <section class="mx-auto max-w-3xl px-5 py-24">
    <p class="font-mono text-sm text-slate-400">404</p>
    <h1 class="mt-2 text-4xl font-bold text-white">Page not found</h1>
    <p class="mt-3 text-slate-300">That page does not exist or has moved.</p>
    <div class="mt-6 flex flex-wrap gap-3">
      <Button href="/" variant="primary">Home</Button>
      <Button href="/commands" variant="secondary">Commands</Button>
    </div>
  </section>
</Layout>
