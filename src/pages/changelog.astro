---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { changelog } from '../data/changelog';

const kinds = {
  new: { label: 'New', cls: 'text-emerald-300' },
  improved: { label: 'Improved', cls: 'text-indigo-300' },
  fix: { label: 'Fixed', cls: 'text-ember-300' },
} as const;
---

<Layout
  title="Changelog | Dragon Bot 2.0"
  description="What's new in Dragon Bot 2.0: new commands, improvements and fixes."
>
  <section class="mx-auto max-w-3xl px-5 pb-6 pt-14">
    <SectionHeader as="h1" title="Changelog" lead="Recent changes to the bot, newest first." />
  </section>

  <section class="mx-auto max-w-3xl px-5 pb-20 pt-4">
    <div class="divide-y divide-slate-800 border-y border-slate-800">
      {changelog.map((entry) => (
        <article class="grid gap-1 py-6 sm:grid-cols-[7rem_1fr] sm:gap-6">
          <p class="text-sm text-slate-400">
            <time>{entry.date}</time>
          </p>
          <div>
            <h2 class="text-lg font-bold text-white">
              {entry.title}
              <span class={`ml-2 text-sm font-medium ${kinds[entry.kind].cls}`}>{kinds[entry.kind].label}</span>
            </h2>
            <p class="mt-2 leading-relaxed text-slate-300">{entry.body}</p>
          </div>
        </article>
      ))}
    </div>
  </section>
</Layout>
