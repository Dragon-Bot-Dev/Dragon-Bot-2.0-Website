---
import Icon from './Icon.astro';
import Rule from './Rule.astro';
import { LINKS, SITE } from '../config';

const year = new Date().getFullYear();

const columns = [
  {
    title: 'Product',
    links: [
      { name: 'Setup guide', href: '/setup' },
      { name: 'Commands', href: '/commands' },
      { name: 'Changelog', href: '/changelog' },
      { name: 'Support the bot', href: '/support' },
    ],
  },
  {
    title: 'Help',
    links: [
      { name: 'FAQ', href: '/faq' },
      { name: 'Discord server', href: LINKS.discord, external: true },
      { name: 'Report a bug', href: LINKS.githubIssues, external: true },
    ],
  },
  {
    title: 'Legal',
    links: [
      { name: 'Privacy Policy', href: '/privacy' },
      { name: 'Terms of Service', href: '/terms' },
    ],
  },
];
---

<footer class="bg-slate-950">
  <Rule />
  <div class="mx-auto grid max-w-6xl gap-10 page-x py-14 md:grid-cols-[1.4fr_2fr]">
    <div>
      <a href="/" class="flex items-center gap-2.5">
        <img src="/dragon.png" alt="" class="h-9 w-9 object-contain" />
        <span class="font-display text-lg font-bold text-white">{SITE.shortName} <span class="text-slate-400">2.0</span></span>
      </a>
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-slate-400">
        A Discord bot that keeps Clash of Clans clans on top of wars, raids and updates.
      </p>
      <div class="mt-5 flex gap-2">
        <a href={LINKS.discord} target="_blank" rel="noopener noreferrer" aria-label="Dragon Bot Discord server"
           class="rounded-lg bg-slate-800 p-2.5 text-slate-300 transition-colors hover:bg-slate-700 hover:text-white">
          <Icon name="discord" size={18} />
        </a>
        <a href={LINKS.github} target="_blank" rel="noopener noreferrer" aria-label="Dragon Bot on GitHub"
           class="rounded-lg bg-slate-800 p-2.5 text-slate-300 transition-colors hover:bg-slate-700 hover:text-white">
          <Icon name="github" size={18} />
        </a>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
      {columns.map((col) => (
        <div>
          <h2 class="font-sans text-xs font-semibold uppercase tracking-widest text-slate-400">{col.title}</h2>
          <ul class="mt-4 space-y-2.5 text-sm">
            {col.links.map((l) => (
              <li>
                <a
                  href={l.href}
                  {...(l.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                  class="text-slate-300 transition-colors hover:text-ember-400"
                >
                  {l.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>

  <Rule />
  <div class="mx-auto flex max-w-6xl flex-col gap-2 page-x py-6 text-xs text-slate-400 sm:flex-row sm:items-center sm:justify-between">
    <p>© {year} Dragon Bot. Developed by Keepas.</p>
    <p>
      Not affiliated with, endorsed, or sponsored by Supercell. All game content and trademarks belong to Supercell.
    </p>
  </div>
</footer>
