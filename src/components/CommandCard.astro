---
import Icon from './Icon.astro';
import type { Command } from '../data/commands';

interface Props extends Command {
  category: string;
}
const { name, desc, scope, usage, admin, category } = Astro.props;
const full = `/${name}`;
---

<article
  class="command-card flex flex-col rounded-lg border border-slate-800 bg-slate-900 p-4"
  data-search={`${name} ${desc} ${category}`.toLowerCase()}
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-mono text-base font-semibold text-ember-300">{full}</h3>
    <button
      type="button"
      class="copy-btn -mr-1.5 -mt-1.5 rounded p-1.5 text-slate-400 hover:text-white"
      data-command={full}
      aria-label={`Copy ${full}`}
    >
      <span class="copy-icon"><Icon name="copy" size={16} /></span>
      <span class="check-icon hidden text-emerald-400"><Icon name="check" size={16} /></span>
    </button>
  </div>

  <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-300">{desc}</p>

  {usage && (
    <p class="mt-3 break-words font-mono text-xs leading-relaxed text-slate-400">{usage}</p>
  )}

  <p class="mt-3 text-xs text-slate-400">
    {scope === 'server' ? 'Needs a linked clan' : 'Works anywhere'}{admin ? ' · Admin only' : ''}
  </p>
</article>
