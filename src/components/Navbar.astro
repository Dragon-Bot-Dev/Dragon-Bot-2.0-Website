---
import Icon from './Icon.astro';
import Button from './Button.astro';
import { NAV, LINKS, SITE } from '../config';

interface Props {
  currentPath?: string;
}
const { currentPath = '/' } = Astro.props;

const isActive = (href: string) =>
  currentPath === href || currentPath === `${href}/`;
---

<header class="sticky top-0 z-50 w-full border-b border-slate-800 bg-slate-950">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5" aria-label="Main">
    <a href="/" class="flex items-center gap-2.5">
      <img src="/dragon.png" alt="" class="h-9 w-9 object-contain" />
      <span class="font-display text-lg font-bold tracking-tight text-white">
        {SITE.shortName} <span class="text-slate-400">2.0</span>
      </span>
    </a>

    <div class="hidden items-center gap-1 md:flex">
      {NAV.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? 'page' : undefined}
          class={`rounded-md px-3 py-1.5 text-sm font-medium transition-colors ${
            isActive(link.href)
              ? 'bg-slate-800 text-white'
              : 'text-slate-400 hover:bg-slate-900 hover:text-white'
          }`}
        >
          {link.name}
          {link.soon && <span class="ml-1 text-xs font-normal text-slate-400">(soon)</span>}
        </a>
      ))}
      <Button href={LINKS.invite} external variant="discord" icon="discord" class="ml-4">Add to Discord</Button>
    </div>

    <button
      id="menu-button"
      type="button"
      class="rounded-lg p-2 text-slate-300 hover:text-white md:hidden"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span data-icon="open"><Icon name="menu" size={24} /></span>
      <span data-icon="close" class="hidden"><Icon name="x" size={24} /></span>
    </button>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-slate-800 bg-slate-950 px-5 py-4 md:hidden">
    <div class="flex flex-col gap-1">
      {NAV.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? 'page' : undefined}
          class={`flex items-center justify-between px-1 py-3 text-base font-medium ${
            isActive(link.href) ? 'text-white' : 'text-slate-300'
          }`}
        >
          {link.name}
          {link.soon && <span class="text-sm font-normal text-slate-400">(soon)</span>}
        </a>
      ))}
      <Button href={LINKS.invite} external variant="discord" icon="discord" class="mt-3 w-full">Add to Discord</Button>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-button');
  const menu = document.getElementById('mobile-menu');
  const openIcon = btn?.querySelector('[data-icon="open"]');
  const closeIcon = btn?.querySelector('[data-icon="close"]');

  function setOpen(open: boolean) {
    menu?.classList.toggle('hidden', !open);
    btn?.setAttribute('aria-expanded', String(open));
    btn?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    openIcon?.classList.toggle('hidden', open);
    closeIcon?.classList.toggle('hidden', !open);
  }

  btn?.addEventListener('click', () => setOpen(menu?.classList.contains('hidden') ?? false));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
</script>
