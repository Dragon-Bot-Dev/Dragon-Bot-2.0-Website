---
import Icon from './Icon.astro';
import type { FaqItem } from '../data/faq';

interface Props {
  items: FaqItem[];
}
const { items } = Astro.props;
---

<div class="divide-y divide-slate-800 border-y border-slate-800">
  {items.map((item) => (
    <details class="group">
      <summary
        class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 text-left font-medium text-white hover:text-ember-300 [&::-webkit-details-marker]:hidden"
      >
        <span>{item.q}</span>
        <Icon name="chevron" size={18} class="shrink-0 text-slate-400 transition-transform group-open:rotate-180" />
      </summary>
      <div class="prose-site pb-5 text-sm" set:html={`<p>${item.a}</p>`} />
    </details>
  ))}
</div>
