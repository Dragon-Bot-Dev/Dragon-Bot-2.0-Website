---
import Icon from './Icon.astro';

interface Props {
  href?: string;
  variant?: 'primary' | 'discord' | 'secondary';
  size?: 'md' | 'lg';
  icon?: string;
  external?: boolean;
  disabled?: boolean;
  class?: string;
}
const {
  href,
  variant = 'primary',
  size = 'md',
  icon,
  external = false,
  disabled = false,
  class: className = '',
} = Astro.props;

const base = 'inline-flex items-center justify-center gap-2 font-semibold rounded-lg transition-colors duration-150';
const sizes = {
  md: 'px-4 py-2 text-sm',
  lg: 'px-5 py-3 text-base',
};
const variants = {
  primary: 'bg-ember-600 text-white hover:bg-ember-500',
  discord: 'bg-blurple text-white hover:bg-blurple-hover',
  secondary: 'border border-slate-700 text-slate-100 hover:bg-slate-800',
};
const disabledCls = 'opacity-50 cursor-not-allowed pointer-events-none';
const cls = `${base} ${sizes[size]} ${variants[variant]} ${disabled ? disabledCls : ''} ${className}`;
const Tag = href && !disabled ? 'a' : 'button';
const extraProps =
  Tag === 'a'
    ? { href, ...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {}) }
    : { disabled, type: 'button' };
---

<Tag class={cls} {...extraProps}>
  {icon && <Icon name={icon} size={size === 'lg' ? 20 : 18} />}
  <slot />
</Tag>
