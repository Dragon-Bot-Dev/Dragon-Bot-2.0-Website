---
import DiscordEmbed from './DiscordEmbed.astro';

interface Props {
  step: number;
  title: string;
  description: string;
  videoSrc?: string;
  command?: string;
  options?: string[];
  note?: string;
  // Shown in place of a video until one is recorded. Replace with videoSrc then.
  mockup?: 'adjust-reminders';
}
const { step, title, description, videoSrc, command, options, note, mockup } = Astro.props;
---

<article class="grid items-start gap-8 border-t border-slate-800 py-10 lg:grid-cols-2 lg:gap-12">
  <div class="min-w-0 space-y-3">
    <p class="font-mono text-sm text-slate-400">Step {step}</p>
    <h2 class="text-2xl font-bold text-white">{title}</h2>
    <p class="leading-relaxed text-slate-300">{description}</p>
    {options && options.length > 0 && (
      <ul class="list-disc space-y-1.5 pl-5 text-sm text-slate-300">
        {options.map((o) => <li set:html={o} />)}
      </ul>
    )}
    {note && (
      <p class="border-l-2 border-ember-500 pl-4 text-sm leading-relaxed text-slate-300">{note}</p>
    )}
  </div>

  <div class="min-w-0">
    {videoSrc ? (
      <div class="overflow-hidden rounded-lg border border-slate-800 bg-black">
        <video
          src={videoSrc}
          controls
          muted
          playsinline
          preload="metadata"
          class="aspect-video w-full"
          aria-label={`Screen recording: ${title}`}
        ></video>
      </div>
    ) : mockup === 'adjust-reminders' ? (
      <DiscordEmbed
        plain
        command="/adjust_reminders news_channel:#updates war_channel:#war"
        footer="Only you can see this"
        caption="Example of the bot's reply. A demo video is coming."
      >
        <p class="font-semibold text-white">✅ Reminders Updated Successfully:</p>
        <ul class="mt-1 list-disc space-y-0.5 pl-5">
          <li>⚔️ War reminders set to <span class="rounded bg-blurple/30 px-1 text-indigo-200">#war</span>.</li>
          <li>📰 News updates set to <span class="rounded bg-blurple/30 px-1 text-indigo-200">#updates</span>.</li>
        </ul>
      </DiscordEmbed>
    ) : command ? (
      <div class="rounded-lg border border-slate-800 bg-slate-900 p-5">
        <p class="text-sm text-slate-400">Run in Discord</p>
        <p class="mt-2 break-words font-mono text-sm text-ember-300">{command}</p>
      </div>
    ) : null}
  </div>
</article>
